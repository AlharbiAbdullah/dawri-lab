{
  "components": {
    "schemas": {
      "Goal": {
        "properties": {
          "additional_minutes": {
            "title": "Additional Minutes",
            "type": "integer"
          },
          "goal_type": {
            "enum": [
              "goal",
              "penalty-goal",
              "own-goal"
            ],
            "title": "Goal Type",
            "type": "string"
          },
          "minute": {
            "title": "Minute",
            "type": "integer"
          },
          "player_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Name"
          },
          "side": {
            "enum": [
              "home",
              "away"
            ],
            "title": "Side",
            "type": "string"
          },
          "team_name": {
            "title": "Team Name",
            "type": "string"
          }
        },
        "required": [
          "minute",
          "additional_minutes",
          "side",
          "team_name",
          "player_name",
          "goal_type"
        ],
        "title": "Goal",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "MatchDetail": {
        "properties": {
          "away": {
            "$ref": "#/components/schemas/MatchTeam"
          },
          "goals": {
            "items": {
              "$ref": "#/components/schemas/Goal"
            },
            "title": "Goals",
            "type": "array"
          },
          "home": {
            "$ref": "#/components/schemas/MatchTeam"
          },
          "kickoff_utc": {
            "format": "date-time",
            "title": "Kickoff Utc",
            "type": "string"
          },
          "match_id": {
            "title": "Match Id",
            "type": "string"
          },
          "season": {
            "title": "Season",
            "type": "string"
          },
          "stadium": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stadium"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "match_id",
          "season",
          "kickoff_utc",
          "status",
          "stadium",
          "home",
          "away",
          "goals"
        ],
        "title": "MatchDetail",
        "type": "object"
      },
      "MatchTeam": {
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "team_name": {
            "title": "Team Name",
            "type": "string"
          }
        },
        "required": [
          "team_name",
          "score"
        ],
        "title": "MatchTeam",
        "type": "object"
      },
      "SeasonSummary": {
        "properties": {
          "finished": {
            "title": "Finished",
            "type": "integer"
          },
          "season": {
            "title": "Season",
            "type": "string"
          },
          "season_id": {
            "title": "Season Id",
            "type": "string"
          },
          "upcoming": {
            "title": "Upcoming",
            "type": "integer"
          }
        },
        "required": [
          "season",
          "season_id",
          "finished",
          "upcoming"
        ],
        "title": "SeasonSummary",
        "type": "object"
      },
      "Standing": {
        "properties": {
          "drawn": {
            "title": "Drawn",
            "type": "integer"
          },
          "goal_difference": {
            "title": "Goal Difference",
            "type": "integer"
          },
          "goals_against": {
            "title": "Goals Against",
            "type": "integer"
          },
          "goals_for": {
            "title": "Goals For",
            "type": "integer"
          },
          "lost": {
            "title": "Lost",
            "type": "integer"
          },
          "played": {
            "title": "Played",
            "type": "integer"
          },
          "points": {
            "title": "Points",
            "type": "integer"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "team_name": {
            "title": "Team Name",
            "type": "string"
          },
          "won": {
            "title": "Won",
            "type": "integer"
          }
        },
        "required": [
          "rank",
          "team_name",
          "played",
          "won",
          "drawn",
          "lost",
          "goals_for",
          "goals_against",
          "goal_difference",
          "points"
        ],
        "title": "Standing",
        "type": "object"
      },
      "TeamMetrics": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        },
        "properties": {
          "team_name": {
            "title": "Team Name",
            "type": "string"
          }
        },
        "required": [
          "team_name"
        ],
        "title": "TeamMetrics",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Dawri",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report that the server is running without querying the database.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/matches/{match_id}": {
      "get": {
        "description": "Return a match's facts, with scores and goals only for finished matches.",
        "operationId": "match_detail_matches__match_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "match_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{32}$",
              "title": "Match Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Match Detail"
      }
    },
    "/seasons": {
      "get": {
        "description": "List configured seasons with their finished and upcoming match counts.",
        "operationId": "seasons_seasons_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SeasonSummary"
                  },
                  "title": "Response Seasons Seasons Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Seasons"
      }
    },
    "/seasons/{season}/metrics": {
      "get": {
        "description": "Ask the same semantic reader as the CLI, preserving requested metric order.",
        "operationId": "metrics_seasons__season__metrics_get",
        "parameters": [
          {
            "in": "path",
            "name": "season",
            "required": true,
            "schema": {
              "title": "Season",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "metric",
            "required": true,
            "schema": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Metric",
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TeamMetrics"
                  },
                  "title": "Response Metrics Seasons  Season  Metrics Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Metrics"
      }
    },
    "/seasons/{season}/standings": {
      "get": {
        "description": "Return one season's existing standings mart in rank order.",
        "operationId": "standings_seasons__season__standings_get",
        "parameters": [
          {
            "in": "path",
            "name": "season",
            "required": true,
            "schema": {
              "title": "Season",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "default": "table",
              "enum": [
                "table",
                "home",
                "away"
              ],
              "title": "Type",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Standing"
                  },
                  "title": "Response Standings Seasons  Season  Standings Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Standings"
      }
    }
  }
}
